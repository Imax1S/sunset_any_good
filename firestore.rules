rules_version = '2';
// sunsetFeedback/{uid}_{date}_{latitude}_{longitude}: authenticated anonymous feedback.
// All fields required and immutable: uid, modelVersion, agrees, forecastDate,
// sunsetAt/retrievedAt/createdAt timestamps, predictionTiming, score/verdict,
// rounded location coordinates, six weather inputs, hazeSource. No free text.
service cloud.firestore {
 match /databases/{database}/documents {
  function isAuthenticated(){return request.auth != null;}
  function isOwner(uid){return isAuthenticated() && request.auth.uid == uid;}
  function bounded(n,low,high){return n is number && n >= low && n <= high;}
  function isValidFeedback(d,id){
   return d.keys().hasAll(['uid','modelVersion','agrees','forecastDate','sunsetAt','retrievedAt','createdAt','predictionTiming','score','verdict','location','weather','hazeSource'])
    && d.keys().hasOnly(['uid','modelVersion','agrees','forecastDate','sunsetAt','retrievedAt','createdAt','predictionTiming','score','verdict','location','weather','hazeSource'])
    && isOwner(d.uid) && d.modelVersion == 'heuristic-v1' && d.agrees is bool
    && d.forecastDate is string && d.forecastDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && id == d.uid + '_' + d.forecastDate + '_' + d.location.latitudeText + '_' + d.location.longitudeText
    && d.createdAt == request.time && d.sunsetAt is timestamp && d.retrievedAt is timestamp
    && d.sunsetAt <= request.time + duration.value(1,'h') && d.sunsetAt > request.time - duration.value(12,'h')
    && d.retrievedAt <= request.time && d.retrievedAt > d.sunsetAt - duration.value(24,'h')
    && ((d.retrievedAt < d.sunsetAt && d.predictionTiming == 'before-sunset') || (d.retrievedAt >= d.sunsetAt && d.predictionTiming == 'after-sunset'))
    && d.score is int && bounded(d.score,0,100)
    && ((d.score < 35 && d.verdict == 'skip') || (d.score >= 35 && d.score < 60 && d.verdict == 'maybe') || (d.score >= 60 && d.score < 85 && d.verdict == 'go') || (d.score >= 85 && d.verdict == 'fuckyes'))
    && d.location is map && d.location.keys().hasAll(['latitude','longitude','latitudeText','longitudeText']) && d.location.keys().hasOnly(['latitude','longitude','latitudeText','longitudeText'])
    && bounded(d.location.latitude,-90,90) && bounded(d.location.longitude,-180,180)
    && d.location.latitudeText is string && d.location.latitudeText.matches('^-?[0-9]{1,2}\\.[0-9]{2}$')
    && d.location.longitudeText is string && d.location.longitudeText.matches('^-?[0-9]{1,3}\\.[0-9]{2}$')
    && d.location.latitudeText.size() <= 6 && d.location.longitudeText.size() <= 7
    && d.weather is map && d.weather.keys().hasAll(['high','mid','low','corridorClear','haze','visibilityKm']) && d.weather.keys().hasOnly(['high','mid','low','corridorClear','haze','visibilityKm'])
    && bounded(d.weather.high,0,100) && bounded(d.weather.mid,0,100) && bounded(d.weather.low,0,100)
    && bounded(d.weather.corridorClear,0,100) && bounded(d.weather.haze,0,100) && bounded(d.weather.visibilityKm,0,1000)
    && d.hazeSource in ['aod','visibility-proxy'];
  }
  match /sunsetFeedback/{id} {
   allow get: if isAuthenticated() && id.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_-?[0-9]{1,2}\\.[0-9]{2}_-?[0-9]{1,3}\\.[0-9]{2}$');
   allow create: if isAuthenticated() && isValidFeedback(request.resource.data,id);
   allow list, update, delete: if false;
  }
  // Isolated end-to-end test records never count as real sunset observations.
  match /sunsetFeedbackChecks/{id} {
   allow get: if isAuthenticated() && id.matches('^' + request.auth.uid + '_.*$');
   allow create: if isAuthenticated() && isValidFeedback(request.resource.data,id);
   allow list, update, delete: if false;
  }
  match /{document=**} {allow read, write: if false;}
 }
}
